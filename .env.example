# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง

# URL ของ Epicor app server (รวมชื่อ instance) เช่น https://erp.company.local/ERPCurrent
EPICOR_BASE_URL=https://your-epicor-server/YourInstance
EPICOR_COMPANY=EPIC06
# v2 (แนะนำ, Kinetic/10.2.500+) หรือ v1
EPICOR_API_VERSION=v2
# จำเป็นสำหรับ REST v2 — สร้างที่ API Key Maintenance ใน Epicor
EPICOR_API_KEY=

# Basic auth (ผู้ใช้ Epicor ที่มีสิทธิ์รัน BAQ)
EPICOR_USERNAME=
EPICOR_PASSWORD=
# หรือใช้ Bearer token แทน username/password
# EPICOR_TOKEN=

# รายการ BAQ ที่จะแสดงในหน้าแรก (คั่นด้วย ,)
EPICOR_BAQ_LIST=

# ถ้า Epicor ใช้ใบรับรองแบบ self-signed: path ไฟล์ .pem และชื่อที่อยู่ในใบรับรอง
# EPICOR_CA_CERT=certs/epicor-server.pem
# EPICOR_TLS_SERVERNAME=YOUR-SERVER-NAME

# BAQ สำหรับหน้า KPI รายเดือน (ดู docs/BAQ-PR-PAYMENT.md)
# EPICOR_BAQ_PR_PAYMENT=zPRPayment
